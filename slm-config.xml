<SLM:system>
    <SLM:component name="mcp2515-driver">
        <SLM:command>/usr/local/bin/mcp2515</SLM:command>
        <SLM:args>-u 0 -v</SLM:args>
        <SLM:waitfor wait="pathname">/dev/io-spi/spi0/dev0</SLM:waitfor>
        <SLM:repair>restart</SLM:repair>
        <SLM:stdout>/var/log/mcp2515-driver.log</SLM:stdout>
        <SLM:stderr>/var/log/mcp2515-driver.err</SLM:stderr>
    </SLM:component>

    <SLM:component name="can-rx-app">
        <SLM:command>/usr/local/bin/appl_can_rx</SLM:command>
        <SLM:depend>mcp2515-driver</SLM:depend>
        <SLM:waitfor wait="pathname">/dev/can0/rx0</SLM:waitfor>
        <SLM:repair>restart</SLM:repair>
        <SLM:stdout>/var/log/appl_can_rx.log</SLM:stdout>
        <SLM:stderr>/var/log/appl_can_rx.err</SLM:stderr>
    </SLM:component>

    <SLM:component name="can-tx-app">
        <SLM:command>/usr/local/bin/appl_can_tx</SLM:command>
        <SLM:depend>mcp2515-driver</SLM:depend>
        <SLM:waitfor wait="pathname">/dev/can0/tx1</SLM:waitfor>
        <SLM:repair>restart</SLM:repair>
        <SLM:stdout>/var/log/appl_can_tx.log</SLM:stdout>
        <SLM:stderr>/var/log/appl_can_tx.err</SLM:stderr>
    </SLM:component>
</SLM:system>

