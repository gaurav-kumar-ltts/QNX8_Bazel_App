#if defined(OPT_ARCH_x86_64)

#define __STARTUP__ startup-x86 -D8250..115200 -zz
#define __DEVB_NAME__ devb-eide
#define __DEVC_NAME__ devc-ser8250
#define __DEVC_PATH__ /dev/ser1

#if defined(IMAGE_TYPE_uefi)
#define __VIRTUAL__ x86_64,uefi
#else
#define __VIRTUAL__ x86_64,multiboot
#endif
#define __LD_QNX__ ldqnx-64.so.2

#define __BOOT_ADDR__ 20m
#define __IOPKT_OPTS__
#define __DEVB_OPTS__
#define __DEVC_OPTS__
#define __HAS_PCI__
#define __PCI_HW_MODULE__ pci_hw-Intel_x86.so

#define __NETDRIVER__ -d vtnet_pci
#define __NETDEVICE__ vtnet0

#elif defined(OPT_ARCH_aarch64le)

#define __BOOT_ADDR__ 0x40080000
#define __VIRTUAL__ aarch64le,raw
#define __STARTUP__ startup-qemu-virt
#define __LD_QNX__ ldqnx-64.so.2
#define __DEVB_NAME__ devb-virtio
#define __DEVB_OPTS__ virtio smem=0xa003e00,irq=79
#define __DEVC_NAME__ devc-serpl011
#define __DEVC_OPTS__ -F 0x9000000,33
#define __DEVC_PATH__ /dev/ser1
#define __NETDRIVER__ -m fdt -d vtnet_mmio
#define __NETDEVICE__ vtnet0

#else
#error Unknown architecture
#endif

#define __PCI_HW_CONFIG_FILE__

#define __GRAPHICS_VIRTIO_DRM__
