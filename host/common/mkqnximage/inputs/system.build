#include "inputs/definitions.inc"
#include "inputs/uids.inc"

#if !defined(OPT_QCFS_no)
[blksize=4096 compblksize=32768 metablksize=4096]
[compressor=__QCFS_COMP__ complvl=__QCFS_COMP_LVL__]
#else
#if defined(OPT_QTD_yes)
# Disk is read-only, no point in having free space. Unfortunately allocating no extra sectors
# causes mkqnx6fsimg to fail.
[num_inodes=*0]
[num_sectors=*80]
#else
#if defined(OPT_QTSAFEFS_yes)
#else
[num_inodes=*__SYS_INODES__]
[num_sectors=*__SYS_SIZE__]
#if defined(__SYS_MAX_SECTORS__)
[max_sectors=__SYS_MAX_SECTORS__]
#endif /* __SYS_MAX_SECTORS__ */
#endif /* OPT_QTSAFEFS_yes */
#endif /* OPT_QTD_yes */
#endif /* OPT_QCFS */
[search=__MKFS_PATH__]

[+dupignore]
[+optional]
[uid=0 gid=0 dperms=755 type=dir] /
[uid=0 gid=0 dperms=755 type=dir] /lib
[uid=0 gid=0 dperms=755 type=dir] /lib/dll
[uid=0 gid=0 dperms=755 type=dir] /bin
[uid=0 gid=0 dperms=755 type=dir] /etc

[perms=444] /etc/build.date = output/build/build.date

__DEFAULT_PERMISSIONS__

#if ! defined(__NO_SYS_FS_EXPANSION__)
needs_expansion = {
}
#endif

# /etc =========================

etc/profile = {
#include "output/inc/_profile.inc"
}

[uid=0 gid=0 dperms=755 perms=555]

[perms=0555] bin/start_net.sh=output/build/start_net.sh

[uid=0 gid=0 dperms=755 type=dir] /etc/startup
/etc/startup/post_startup.sh=output/build/post_startup.sh

