/bin/drm-virtio=sbin/drm-virtio
/lib/dll/screen-virtiodrm.so=lib/dll/screen-virtiodrm.so

 ####################################################################################
 ###  virtio gpu
 ####################################################################################
/graphics/driver/gpu_drm-virtio.so=usr/lib/graphics/virtio-drm/gpu_drm-virtio.so
/graphics/driver/libEGL-mesa.so=usr/lib/graphics/virtio-drm/libEGL-mesa.so
/graphics/driver/libGLESv2-mesa.so=usr/lib/graphics/virtio-drm/libGLESv2-mesa.so
/graphics/driver/libWFDvirtio-drm.so=usr/lib/graphics/virtio-drm/libWFDvirtio-drm.so
/graphics/driver/libglapi-mesa.so=usr/lib/graphics/virtio-drm/libglapi-mesa.so
/graphics/driver/libwfdcfg-virtio-generic.so=usr/lib/graphics/virtio-drm/libwfdcfg-virtio-generic.so
/graphics/driver/virtio_gpu_dri.so=usr/lib/graphics/virtio-drm/virtio_gpu_dri.so

/graphics/driver/graphics.conf={
begin khronos

  begin egl display 1
    egl-dlls = libglapi-mesa.so libEGL-mesa.so
    glesv2-dlls = libglapi-mesa.so libGLESv2-mesa.so
    gpu-dlls = gpu_drm-virtio.so
  end egl display

  begin wfd device 1
    wfd-dlls = libwfdcfg-virtio-generic.so libWFDvirtio-drm.so

    # Run "drm-probe-displays" to list the available displays and pipelines,
    # and "use $GRAPHICS_ROOT/libWFDvirtio-drm.so" for more information on
    # these driver-specific settings.

    # Pipeline IDs 1 to 9 are used for DRM CRTCs.  One should be assigned
    # to each display that will be used.
    pipeline1-display = 1
  end wfd device

end khronos

begin winmgr

  begin globals
    default-display = 1
    # Adjust the stack size of Screen's resmgr threads.  The default size
    # is insufficient for blitters/compositors using Mesa (e.g., gles2blt).
    stack-size = 65536  # in units of bytes
    blit-config = virtiodrm
    alloc-config = virtiodrm
    requests-logsize = 65536
    blits-logsize = 4096
    blit-defer = false
    keymap = /system/graphics/keyboard/en_US_101
  end globals

  begin display 1
    video-mode = 1280 x 720 @ 60
    # Adjust the stack size of Screen's composition thread; required when the
    # display's framebuffer uses Mesa (e.g., "usage = gles2"), as noted above.
    stack-size = 65536  # in units of bytes
    defer-framebuffer-creation = false
  end display

  begin class framebuffer-1
    display = 1
    pipeline = 1
    format = rgba8888
    usage = virtiodrm
  end class

end winmgr
}
