<!-- local/snippets/slm.custom
     Custom slm configuration
-->

  <SLM:component name="xnm-app">
    <SLM:depend>network-init</SLM:depend>
    <SLM:command>/data/xnm/xnm_app</SLM:command>
    <SLM:args>--config /data/xnm/xnm_config.json</SLM:args>
    <SLM:waitfor wait="exit" />
    SLMTYPE_P(slm_t)
  </SLM:component>
