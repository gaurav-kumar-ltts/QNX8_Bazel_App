# local/snippets/data_files.custom
# Placeholder for local list of files to add to data partition

# xnm_app: brings up the VLAN sub-interfaces and pf firewall rules at boot
# (see QNX8_App/xnm_app/xnm_config.json and slm.custom's xnm-app component).
# __TOOL_DIR__ expands to host/common/mkqnximage; walk back up to the repo
# root to pull files straight from the Bazel app's own source tree instead
# of duplicating them here. Build the binary first:
#   bazel build --config=qnx_aarch64 //:xnm_app   (from QNX8_App/xnm_app)
[uid=0 gid=0 dperms=755 type=dir] xnm
[uid=0 gid=0 perms=644] xnm/xnm_config.json=__TOOL_DIR__/../../../QNX8_App/xnm_app/xnm_config.json
[uid=0 gid=0 perms=555] xnm/xnm_app=__TOOL_DIR__/../../../QNX8_App/xnm_app/bazel-bin/xnm_app
