#include "inputs/definitions.inc"
[search=__MKFS_PATH__]
[num_inodes=*]
[num_sectors=*80]
bin/shutdown=sbin/shutdown
bin/slay=bin/slay
bin/sync=bin/sync
needs_install = {
}
part.info=output/build/part.info
systemupdate.sh=output/build/systemupdate.sh
# Include build.date so that the mount_fs.sh script doesn't view the file system
# as corrupt.
etc/build.date=output/build/build.date
[perms=555] updatefs.sh=__TOOL_DIR__/inputs/updatefs.sh
[perms=555] installfs=__TOOL_DIR__/inputs/installfs
