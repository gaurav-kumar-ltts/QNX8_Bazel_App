#define __DEVB_NAME__ devb-sdmmc-bcm2711
#define __DEVB_OPTS__ mem name=below1G sdio addr=0xfe340000,irq=158

#define __DEVC_NAME__ devc-serminiuart
#define __DEVC_OPTS__ -b115200 -c500000000 -e -F -u1 0xfe215000,125
#define __DEVC_PATH__ /dev/ser1

# Options Can configure watchdog with -W <time>
#define __STARTUP__ startup-bcm2711-rpi4 -D miniuart -u bootm

#define __HAS_PCI__
#define __PCI_HW_MODULE__ pci_hw-bcm2711-rpi4.so
#define __PCI_BUSCFG_MODULE__ pci_server-buscfg-generic.so

#define __NETDRIVER__ -m fdt -d genet
#define __NETDEVICE__ genet0

#define __WIFIDRIVER__ -o config=/system/etc/io-sock/io-sock.conf -d qwdi_dhd_sdio-2_11-rpi4
#define __WIFIDEVICE__ bcm0

#define __IOSOCK_OPTIONS__

#define __BOOT_ADDR__ 0x80000

#define __VIRTUAL__ aarch64le,raw

#define __LD_QNX__ ldqnx-64.so.2

#undef __IO_USB_OTG_OPTIONS__
#define __IO_USB_OTG_OPTIONS__ -t memory=below1G -d bcm2711-xhci pindex=0,memory=below1G
