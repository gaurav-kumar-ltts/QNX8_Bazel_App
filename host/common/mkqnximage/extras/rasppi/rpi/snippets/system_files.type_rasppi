#if defined(OPT_IO_SOCK_DIAG_yes)
lib/dll/devs-genet-diag.so=lib/dll/devs-genet-diag.so
#else
lib/dll/devs-genet.so=lib/dll/devs-genet.so
#endif

bin/mbox-bcm2711=bin/mbox-bcm2711

#if defined(OPT_USB_yes)
lib/dll/devu-hcd-bcm2711-xhci.so=lib/dll/devu-hcd-bcm2711-xhci.so
#endif

lib/dll/devs-qwdi_dhd_sdio-2_11-rpi4.so=lib/dll/devs-qwdi_dhd_sdio-2_11-rpi4.so

[perms=444] etc/wifi/firmware/cyfmac43455-sdio.bin=cyfmac43455-sdio.bin
[perms=444] etc/wifi/firmware/cyfmac43455-sdio.clm_blob=cyfmac43455-sdio.clm_blob
[perms=444] etc/wifi/firmware/brcmfmac43455-sdio.raspberrypi,4-model-b.txt=brcmfmac43455-sdio.raspberrypi,4-model-b.txt

[perms=644] etc/io-sock/io-sock.conf = {
hw.dhdsdio.dev0="rpi4"
dev.qwdi_wifi.conf="/system/etc/wifi/qwdi_wifi.conf"
}

[perms=644] etc/wifi/qwdi_wifi.conf = {
fw=/system/etc/wifi/firmware/cyfmac43455-sdio.bin
nvram=/system/etc/wifi/firmware/brcmfmac43455-sdio.raspberrypi,4-model-b.txt
clm_blob=/system/etc/wifi/firmware/cyfmac43455-sdio.clm_blob
sdio_baseaddr=0xfe300000
sdio_irq=158
drv_supp=3
key_delay=5
sdio_verbose=0
dhd_verbose=1
qwdi_dbg_level=0
}
