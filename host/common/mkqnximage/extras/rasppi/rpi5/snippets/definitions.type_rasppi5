#define __DEVB_NAME__ devb-sdmmc-bcm2712
#define __DEVB_OPTS__ sdio addr=0x1000fff000,irq=305 disk name=hd

#define __DEVC_NAME__ devc-serpl011-rpi5
#define __DEVC_OPTS__ -b115200 -c44236800 -F -u10 -D 0x107d001000^2
#define __DEVC_PATH__ /dev/ser10

#define __STARTUP__ startup-bcm2712-rpi5 -u reg -a

#define __HAS_PCI__
#define __PCI_HW_MODULE__ pci_hw-bcm2712-rpi5.so
#define __PCI_HW_CUSTOM_CONFIG_FILE__ pci_hw-bcm2712-rpi5.cfg
#define __PCI_BUSCFG_MODULE__ pci_server-buscfg-generic.so

#define __NETDRIVER__ -m fdt -d cgem -m usb -d axe -d axge -d cdce -d smsc
#define __NETDEVICE__ cgem0

#define __IOSOCK_OPTIONS__

#define __BOOT_ADDR__ 0x8000000

#define __VIRTUAL__ aarch64le,raw

#define __LD_QNX__ ldqnx-64.so.2

#undef __IO_USB_OTG_OPTIONS__
#define __IO_USB_OTG_OPTIONS__ -v -d dwc3-xhci ioport=0x1f00200000,irq=0xbf,iosize=0x100000,bmstr=0x1000000000,ioport=0x1f00300000,irq=0xc4,iosize=0x100000,bmstr=0x1000000000
