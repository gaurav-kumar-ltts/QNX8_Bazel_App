    procmgr_symlink __IFS_PATH__/ldqnx-64.so.2 /usr/lib/ldqnx-64.so.2
#if defined(OPT_UNION_no)
    # As various programs expect some binaries in fixed location,
    # create procmgr symlinks to them.
    procmgr_symlink __IFS_PATH__/ksh /bin/ksh
    procmgr_symlink __IFS_PATH__/ksh /bin/sh
    procmgr_symlink __IFS_PATH__/toybox /bin/cp
    procmgr_symlink __IFS_PATH__/toybox /bin/rm
    procmgr_symlink /system/bin/ssh /usr/bin/ssh
    procmgr_symlink /data/var/tmp /tmp
    procmgr_symlink /system/etc/terminfo /usr/share/terminfo
    procmgr_symlink /data/var/etc /etc
    procmgr_symlink /data/var /var
#endif

    TERM=qansi
    HOME=/data/home/root
#if defined(__HAS_PCI__)
    PCI_BKWD_COMPAT_MODULE=__IFS_PATH__/pci_bkwd_compat.so
    PCI_SLOG_MODULE=pci_slog2.so
    PCI_CAP_MODULE_DIR=__IFS_PATH__
#endif
