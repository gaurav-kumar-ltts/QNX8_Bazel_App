# Force Bazel to route execution logic straight to the custom parameters
build:qnx_aarch64 --repo_env=CC=/home/prathik/qnx800/host/linux/x86_64/usr/bin/qcc
build:qnx_aarch64 --action_env=CC=/home/prathik/qnx800/host/linux/x86_64/usr/bin/qcc
build:qnx_aarch64 --action_env=CXX=/home/prathik/qnx800/host/linux/x86_64/usr/bin/qcc

# CRITICAL: Forces Bazel's auto-configuration engine to bind the variables above
build:qnx_aarch64 --action_env=BAZEL_COMPILER=qcc

# Target configuration strings passed to the wrapper
build:qnx_aarch64 --copt=-Vgcc_ntoaarch64le
build:qnx_aarch64 --linkopt=-Vgcc_ntoaarch64le
build:qnx_aarch64 --copt=-D_XOPEN_SOURCE=600

# Keep the standard shell context active inside sandboxed environment spaces
build:qnx_aarch64 --noexperimental_strict_action_env
build:qnx_aarch64 --action_env=QNX_HOST=/home/prathik/qnx800/host/linux/x86_64
build:qnx_aarch64 --action_env=QNX_TARGET=/home/prathik/qnx800/target/qnx

# === ADD THE LICENSING & JOB MITIGATION FIXES HERE ===
build:qnx_aarch64 --sandbox_writable_path=/home/prathik/.qnx/license/
build:qnx_aarch64 --sandbox_add_mount_pair=/home/prathik/.qnx
#build:qnx_aarch64 --local_cpu_resources=2
build:qnx_aarch64 --jobs=2
