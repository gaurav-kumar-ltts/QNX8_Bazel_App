# *******************************************************************************
# S-CORE QNX Cross-Compile Toolchain Configuration (Raspi 5 / AArch64)
# *******************************************************************************
gcc = use_extension("@score_bazel_cpp_toolchains//extensions:gcc.bzl", "gcc")

# Generiert die QCC-Toolchain für QNX auf AArch64-Hardware
gcc.toolchain(
    name = "score_qcc_aarch64_toolchain",
    sdp_version = "8.0.0",     # Falls Sie QNX 7.1 nutzen, hier "7.1.0" eintragen
    target_cpu = "aarch64",
    target_os = "qnx",
    use_default_package = True,
)

use_repo(gcc, "score_qcc_aarch64_toolchain")

# Registriert die generierte QNX-Toolchain im System
register_toolchains("@score_qcc_aarch64_toolchain//:all")


# *******************************************************************************
# S-CORE Registries Overrides (Bypass public BCR lookup)
# *******************************************************************************
git_override(
    module_name = "score_bazel_platforms",
    remote = "https://github.com",
    commit = "de2ee8568cda3bdfb39ee9302ca171fb2a188be2", # Pin to the commit matching 0.1.2
)

git_override(
    module_name = "score_bazel_cpp_toolchains",
    remote = "https://github.com",
    branch = "main", 
)

# *******************************************************************************
# S-CORE Repository Overrides
# *******************************************************************************
git_override(
    module_name = "score_bazel_platforms",
    remote = "https://github.com",
    branch = "main",
)

git_override(
    module_name = "score_bazel_cpp_toolchains",
    remote = "https://github.com",
