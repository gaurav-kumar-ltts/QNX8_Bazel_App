# QNX Environment Setup
build:qnx_aarch64 --repo_env=PATH=/home/khalil/prathik/QNX8_Bazel_App/QNX8_App/someip_app:/home/khalil/qnx800/host/linux/x86_64/usr/bin:/usr/bin:/bin
build:qnx_aarch64 --action_env=PATH=/home/khalil/prathik/QNX8_Bazel_App/QNX8_App/someip_app:/home/khalil/qnx800/host/linux/x86_64/usr/bin:/usr/bin:/bin
build:qnx_aarch64 --repo_env=CC=qcc_wrapper.sh
build:qnx_aarch64 --action_env=CC=qcc_wrapper.sh
build:qnx_aarch64 --action_env=CXX=qcc_wrapper.sh
build:qnx_aarch64 --action_env=BAZEL_COMPILER=qcc
build:qnx_aarch64 --action_env=QNX_HOST=/home/khalil/qnx800/host/linux/x86_64
build:qnx_aarch64 --action_env=QNX_TARGET=/home/khalil/qnx800/target/qnx
build:qnx_aarch64 --action_env=HOME=/home/khalil
build:qnx_aarch64 --action_env=USER=khalil

# Architecture Flags
build:qnx_aarch64 --copt=-Vgcc_ntoaarch64le_cxx # changed
build:qnx_aarch64 --linkopt=-Vgcc_ntoaarch64le_cxx # changed
build:qnx_aarch64 --copt=-D_XOPEN_SOURCE=600

# Allow sandbox access to QNX directories
build:qnx_aarch64 --sandbox_add_mount_pair=/home/khalil/qnx800

# Allow sandbox access to project directories outside this workspace root
# (dlt-daemon build output and boost_qnx_aarch64 live under the parent QNX8_Bazel_App tree)
build:qnx_aarch64 --sandbox_add_mount_pair=/home/khalil/prathik/QNX8_Bazel_App

# Grant writable access and mount the QNX license directory into the sandbox
build:qnx_aarch64 --sandbox_writable_path=/home/khalil/.qnx
build:qnx_aarch64 --sandbox_add_mount_pair=/home/khalil/.qnx

# Pass home/user context to qcc driver
build:qnx_aarch64 --action_env=HOME=/home/khalil
build:qnx_aarch64 --action_env=USER=khalil
