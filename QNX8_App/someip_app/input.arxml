<?xml version="1.0" encoding="UTF-8"?>
<AUTOSAR xmlns="http://autosar.org/schema/r4.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://autosar.org/schema/r4.0 AUTOSAR_4-2-2.xsd">
  <AR-PACKAGES>
    <AR-PACKAGE>
      <SHORT-NAME>ExampleApp</SHORT-NAME>
      <AR-PACKAGES>

        <!-- ============ Service Interface (Port Interface) ============ -->
        <AR-PACKAGE>
          <SHORT-NAME>PortInterfaces</SHORT-NAME>
          <ELEMENTS>
            <SERVICE-INTERFACE>
              <SHORT-NAME>ExampleService_SI</SHORT-NAME>
              <SERVICE-INTERFACE-ID>1234</SERVICE-INTERFACE-ID>
              <IS-SERVICE>true</IS-SERVICE>
              <!-- Eventgroup grouping the event for SD subscription -->
              <EVENT-GROUPS>
                <EVENT-GROUP>
                  <SHORT-NAME>ExampleEventGroup</SHORT-NAME>
                  <EVENT-GROUP-ID>1</EVENT-GROUP-ID>
                  <EVENT-REFS>
                    <EVENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/ExampleApp/PortInterfaces/ExampleService_SI/ExampleEvent</EVENT-REF>
                  </EVENT-REFS>
                </EVENT-GROUP>
              </EVENT-GROUPS>

            </SERVICE-INTERFACE>

            <SERVICE-INTERFACE>
              <SHORT-NAME>ExampleConsumer_SI</SHORT-NAME>
              <SERVICE-INTERFACE-ID>2345</SERVICE-INTERFACE-ID>
              <IS-SERVICE>true</IS-SERVICE>
              <EVENT-GROUPS>
                <EVENT-GROUP>
                  <SHORT-NAME>ExampleConsumerEventGroup</SHORT-NAME>
                  <EVENT-GROUP-ID>2</EVENT-GROUP-ID>
                  <EVENT-REFS>
                    <EVENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/ExampleApp/PortInterfaces/ExampleConsumer_SI/ExampleConsumerEvent</EVENT-REF>
                  </EVENT-REFS>
                </EVENT-GROUP>
              </EVENT-GROUPS>
            </SERVICE-INTERFACE>
          </ELEMENTS>
        </AR-PACKAGE>

        <!-- ============ Provided/Required service instance (deployment) ============ -->
        <AR-PACKAGE>
          <SHORT-NAME>SystemDeployment</SHORT-NAME>
          <ELEMENTS>
            <PROVIDED-SERVICE-INSTANCE>
              <SHORT-NAME>ExampleService_ProvidedInstance</SHORT-NAME>
              <SERVICE-INTERFACE-REF DEST="SERVICE-INTERFACE">/ExampleApp/PortInterfaces/ExampleService_SI</SERVICE-INTERFACE-REF>
              <SERVICE-INTERFACE-DEPLOYMENT-REF DEST="SOMEIP-SERVICE-INTERFACE-DEPLOYMENT">
                /ExampleApp/SomeipDeployment/ExampleService_SomeipDeployment
              </SERVICE-INTERFACE-DEPLOYMENT-REF>
              <INSTANCE-IDENTIFIER>1</INSTANCE-IDENTIFIER>
            </PROVIDED-SERVICE-INSTANCE>

            <REQUIRED-SERVICE-INSTANCE>
              <SHORT-NAME>ExampleConsumer_RequiredInstance</SHORT-NAME>
              <SERVICE-INTERFACE-REF DEST="SERVICE-INTERFACE">/ExampleApp/PortInterfaces/ExampleConsumer_SI</SERVICE-INTERFACE-REF>
              <SERVICE-INTERFACE-DEPLOYMENT-REF DEST="SOMEIP-SERVICE-INTERFACE-DEPLOYMENT">
                /ExampleApp/SomeipDeployment/ExampleConsumer_SomeipDeployment
              </SERVICE-INTERFACE-DEPLOYMENT-REF>
              <INSTANCE-IDENTIFIER>2</INSTANCE-IDENTIFIER>
            </REQUIRED-SERVICE-INSTANCE>
          </ELEMENTS>
        </AR-PACKAGE>

        <!-- ============ SOME/IP-specific deployment (IDs, transport) ============ -->
        <AR-PACKAGE>
          <SHORT-NAME>SomeipDeployment</SHORT-NAME>
          <ELEMENTS>
            <SOMEIP-SERVICE-INTERFACE-DEPLOYMENT>
              <SHORT-NAME>ExampleService_SomeipDeployment</SHORT-NAME>
              <SERVICE-INTERFACE-REF DEST="SERVICE-INTERFACE">/ExampleApp/PortInterfaces/ExampleService_SI</SERVICE-INTERFACE-REF>
              <SERVICE-INTERFACE-ID>1234</SERVICE-INTERFACE-ID> <!-- 0x04D2 -->
              <SERVICE-INTERFACE-VERSION>
                <MAJOR-VERSION>1</MAJOR-VERSION>
                <MINOR-VERSION>0</MINOR-VERSION>
              </SERVICE-INTERFACE-VERSION>

              <METHOD-DEPLOYMENTS>
                <SOMEIP-METHOD-DEPLOYMENT>
                  <METHOD-REF DEST="CLIENT-SERVER-OPERATION">/ExampleApp/PortInterfaces/ExampleService_SI/ExampleMethod</METHOD-REF>
                  <METHOD-ID>1</METHOD-ID>
                  <TRANSPORT-PROTOCOL>UDP</TRANSPORT-PROTOCOL>
                </SOMEIP-METHOD-DEPLOYMENT>
              </METHOD-DEPLOYMENTS>

              <EVENT-DEPLOYMENTS>
                <SOMEIP-EVENT-DEPLOYMENT>
                  <EVENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/ExampleApp/PortInterfaces/ExampleService_SI/ExampleEvent</EVENT-REF>
                  <EVENT-ID>32769</EVENT-ID> <!-- 0x8001 -->
                  <TRANSPORT-PROTOCOL>UDP</TRANSPORT-PROTOCOL>
                </SOMEIP-EVENT-DEPLOYMENT>
              </EVENT-DEPLOYMENTS>

              <EVENT-GROUP-DEPLOYMENTS>
                <SOMEIP-EVENT-GROUP-DEPLOYMENT>
                  <EVENT-GROUP-REF DEST="EVENT-GROUP">/ExampleApp/PortInterfaces/ExampleService_SI/ExampleEventGroup</EVENT-GROUP-REF>
                  <EVENT-GROUP-ID>1</EVENT-GROUP-ID>
                </SOMEIP-EVENT-GROUP-DEPLOYMENT>
              </EVENT-GROUP-DEPLOYMENTS>
            </SOMEIP-SERVICE-INTERFACE-DEPLOYMENT>

            <SOMEIP-SERVICE-INTERFACE-DEPLOYMENT>
              <SHORT-NAME>ExampleConsumer_SomeipDeployment</SHORT-NAME>
              <SERVICE-INTERFACE-REF DEST="SERVICE-INTERFACE">/ExampleApp/PortInterfaces/ExampleConsumer_SI</SERVICE-INTERFACE-REF>
              <SERVICE-INTERFACE-ID>2345</SERVICE-INTERFACE-ID> <!-- 0x0929 -->
              <SERVICE-INTERFACE-VERSION>
                <MAJOR-VERSION>1</MAJOR-VERSION>
                <MINOR-VERSION>0</MINOR-VERSION>
              </SERVICE-INTERFACE-VERSION>

              <EVENT-DEPLOYMENTS>
                <SOMEIP-EVENT-DEPLOYMENT>
                  <EVENT-REF DEST="VARIABLE-DATA-PROTOTYPE">/ExampleApp/PortInterfaces/ExampleConsumer_SI/ExampleConsumerEvent</EVENT-REF>
                  <EVENT-ID>32770</EVENT-ID> <!-- 0x8002 -->
                  <TRANSPORT-PROTOCOL>UDP</TRANSPORT-PROTOCOL>
                </SOMEIP-EVENT-DEPLOYMENT>
              </EVENT-DEPLOYMENTS>

              <EVENT-GROUP-DEPLOYMENTS>
                <SOMEIP-EVENT-GROUP-DEPLOYMENT>
                  <EVENT-GROUP-REF DEST="EVENT-GROUP">/ExampleApp/PortInterfaces/ExampleConsumer_SI/ExampleConsumerEventGroup</EVENT-GROUP-REF>
                  <EVENT-GROUP-ID>2</EVENT-GROUP-ID>
                </SOMEIP-EVENT-GROUP-DEPLOYMENT>
              </EVENT-GROUP-DEPLOYMENTS>
            </SOMEIP-SERVICE-INTERFACE-DEPLOYMENT>
          </ELEMENTS>
        </AR-PACKAGE>

        <!-- ============ Network/SD config: IP, port, multicast ============ -->
        <AR-PACKAGE>
          <SHORT-NAME>NetworkConfig</SHORT-NAME>
          <ELEMENTS>
            <SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
              <SHORT-NAME>ExampleService_NetworkMapping</SHORT-NAME>
              <SERVICE-INSTANCE-REF DEST="PROVIDED-SERVICE-INSTANCE">/ExampleApp/SystemDeployment/ExampleService_ProvidedInstance</SERVICE-INSTANCE-REF>
              <INSTANCE-ID>1</INSTANCE-ID> <!-- 0x0001 -->
              <UNICAST-IP-ADDRESS>10.20.30.42</UNICAST-IP-ADDRESS>
              <PORT-NUMBER>30501</PORT-NUMBER>
              <PROTOCOL>UDP</PROTOCOL>
              <MULTICAST-IP-ADDRESS>224.224.224.245</MULTICAST-IP-ADDRESS>
              <MULTICAST-PORT-NUMBER>30490</MULTICAST-PORT-NUMBER>
              <SD-PORT-NUMBER>30490</SD-PORT-NUMBER>
            </SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>

            <SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
              <SHORT-NAME>ExampleConsumer_NetworkMapping</SHORT-NAME>
              <SERVICE-INSTANCE-REF DEST="REQUIRED-SERVICE-INSTANCE">/ExampleApp/SystemDeployment/ExampleConsumer_RequiredInstance</SERVICE-INSTANCE-REF>
              <INSTANCE-ID>2</INSTANCE-ID> <!-- 0x0002 -->
              <UNICAST-IP-ADDRESS>10.20.30.42</UNICAST-IP-ADDRESS>
              <PORT-NUMBER>30502</PORT-NUMBER>
              <PROTOCOL>UDP</PROTOCOL>
              <MULTICAST-IP-ADDRESS>224.224.224.246</MULTICAST-IP-ADDRESS>
              <MULTICAST-PORT-NUMBER>30491</MULTICAST-PORT-NUMBER>
              <SD-PORT-NUMBER>30490</SD-PORT-NUMBER>
            </SOMEIP-SERVICE-INSTANCE-TO-MACHINE-MAPPING>
          </ELEMENTS>
        </AR-PACKAGE>

      </AR-PACKAGES>
    </AR-PACKAGE>
  </AR-PACKAGES>
</AUTOSAR>
