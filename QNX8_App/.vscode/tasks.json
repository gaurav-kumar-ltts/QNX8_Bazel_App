{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build QNX App",
            "command": "qcc",
            "args": [
                "-V", "gcc_ntoaarch64le",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
