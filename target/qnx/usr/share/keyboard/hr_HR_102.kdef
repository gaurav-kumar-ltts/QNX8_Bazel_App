// file hr_HR_102.kbd

Keyboard "hr_HR_102" {

	include "altgr.inc"
	include "common.inc"


	KeyType "NumberLettersDead" {
		NoSym <Ctrl>
		NoSym <Alt>
		Unmodified Sym #1
		<Caps_Lock> Sym #2
		<Shift> Sym #3
		<Shift> + <Caps_Lock> Sym #3
		<AltGr> Deadkey #4
		<AltGr> + <Shift> Deadkey #4
		<AltGr> + <Caps_Lock> Deadkey #4
		<AltGr> + <Caps_Lock> + <Shift> Deadkey #4
		}
		
	KeyType "FourLevelLetter" {
		NoSym <Ctrl>
		NoSym <Alt>
		Unmodified Sym #1
		<Caps_Lock> Sym #2
		<Shift> Sym #3
		<Shift> + <Caps_Lock> Sym #3
