# ==============================================================================
# 1. GENERAL BUILD TRASH & TEMPORARY FILES
# ==============================================================================
*.o
*.so
*.a
*~
*.log
*.bin

# ==============================================================================
# 2. QNX WORKSPACE & COMPILED BINARIES (From qnx800_2)
# ==============================================================================
# Ignore the pre-compiled host toolchains and utilities
qnx-image-build/qnx800_2/host/

# Ignore target architecture binaries (libs, binaries built for hardware targets)
qnx-image-build/qnx800_2/target/

# Ignore final generated system boot images (IFS, EFS, system images)
qnx-image-build/qnx800_2/images/
*.ifs
*.efs

# ==============================================================================
# 3. IDE / EDITOR WORKSPACES
# ==============================================================================
.vscode/
qnx-image-build/qnx800_2/.vscode/
.idea/
.project
.cproject

# ==============================================================================
# 4. WHITELIST RULES (Always Track Crucial Build Files & Configurations)
# ==============================================================================
# Force Git to never ignore Makefiles, even if they sit inside a discarded tree folder
!**/Makefile
!**/*.mk

# Ensure your critical QNX environment launch scripts are tracked
!qnx-image-build/qnx800_2/qnxsdp-env.sh
!qnx-image-build/qnx800_2/qnxsdp-env.bat

